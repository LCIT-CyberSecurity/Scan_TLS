# Copy to .env (the bootstrap does it and generates every secret). NEVER commit .env.
# Former TLS_SCAN_* names are still read when the ORION_* name is absent; ./bootstrap_orion-deployment.sh migrate-config renames them.
ORION_PROJECT=orion
# PostgreSQL database and role of this installation. An installation made before the Orion rebranding uses tls_scan
# for both: the bootstrap pins that value and never renames a live database (see docs/admin/orion-migration.md).
ORION_DB_NAME=orion
ORION_DB_USER=orion
ORION_VERSION=local
ORION_HTTPS_PORT=8443
ORION_HTTP_PORT=8080
ORION_SECRET_DIR=./data/secrets
# The bootstrap sets this to the host group used for the protected files; do not change without reviewing access.
ORION_SECRET_GID=
# Public URL users type in their browser (used for SSO redirects and links in e-mails).
ORION_PUBLIC_BASE_URL=https://localhost:8443
ORION_COOKIE_SECURE=true

# Limits
ORION_MAX_CONCURRENT_SCANS=2
ORION_MAX_SCAN_DURATION_SECONDS=3600
ORION_MAX_TARGETS_PER_SCAN=4096
ORION_MAX_SCAN_WORKERS=8

# SSO (optional). Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
ORION_OIDC_PROVIDER=
ORION_OIDC_ISSUER=
ORION_OIDC_CLIENT_ID=
ORION_OIDC_DEFAULT_ROLE=USER
# Preferably configured in Administration -> Authentication (see docs/admin/authentication.md). Keep all secrets in ORION_SECRET_DIR:
# ORION_SSO_AUTO_PROVISION=false

# Greenbone import (read-only). GMP hosts must match this exact allowlist.
# Configure password and certificate paths using protected Docker secrets or *_FILE variables.
ORION_GREENBONE_ALLOWED_HOSTS=
ORION_GREENBONE_USERNAME=
# Set these paths only when the matching protected file has been installed under ORION_SECRET_DIR.
ORION_GREENBONE_CA_FILE=
ORION_GREENBONE_CLIENT_CERT_FILE=
ORION_GREENBONE_CLIENT_KEY_FILE=
ORION_GOOGLE_DIRECTORY_KEY_FILE=

# Optional read-only SNMPv3 authPriv identity. Keys are managed as protected files by bootstrap.
ORION_SNMP_V3_USERNAME=

# Secrets (PostgreSQL, session, SSO/LDAP, SMTP, Greenbone and SNMP) are kept in protected files under
# ORION_SECRET_DIR. Do not add *_PASSWORD, *_SECRET or key values here.
