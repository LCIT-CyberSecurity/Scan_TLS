# Copy to .env (the bootstrap does it and generates every secret). NEVER commit .env.
TLS_SCAN_PROJECT=tls-scan
TLS_SCAN_VERSION=local
TLS_SCAN_HTTPS_PORT=8443
TLS_SCAN_HTTP_PORT=8080
# Public URL users type in their browser (used for SSO redirects and links in e-mails).
TLS_SCAN_PUBLIC_BASE_URL=https://localhost:8443
POSTGRES_PASSWORD=
TLS_SCAN_SESSION_SECRET=
TLS_SCAN_COOKIE_SECURE=true

# Limits
TLS_SCAN_MAX_CONCURRENT_SCANS=2
TLS_SCAN_MAX_SCAN_DURATION_SECONDS=3600
TLS_SCAN_MAX_TARGETS_PER_SCAN=4096
TLS_SCAN_MAX_SCAN_WORKERS=8

# SSO (optional). Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
TLS_SCAN_OIDC_PROVIDER=
TLS_SCAN_OIDC_ISSUER=
TLS_SCAN_OIDC_CLIENT_ID=
TLS_SCAN_OIDC_CLIENT_SECRET=
TLS_SCAN_OIDC_DEFAULT_ROLE=USER

# SMTP password (host/port/sender are configured in the UI)
TLS_SCAN_SMTP_PASSWORD=
