# Copy to .env (the bootstrap does it and generates every secret). NEVER commit .env.
TLS_SCAN_PROJECT=tls-scan
TLS_SCAN_VERSION=local
TLS_SCAN_HTTPS_PORT=8443
TLS_SCAN_HTTP_PORT=8080
TLS_SCAN_SECRET_DIR=./data/secrets
# The bootstrap sets this to the host group used for the protected files; do not change without reviewing access.
TLS_SCAN_SECRET_GID=
# Public URL users type in their browser (used for SSO redirects and links in e-mails).
TLS_SCAN_PUBLIC_BASE_URL=https://localhost:8443
TLS_SCAN_COOKIE_SECURE=true

# Limits
TLS_SCAN_MAX_CONCURRENT_SCANS=2
TLS_SCAN_MAX_SCAN_DURATION_SECONDS=3600
TLS_SCAN_MAX_TARGETS_PER_SCAN=4096
TLS_SCAN_MAX_SCAN_WORKERS=8

# SSO (optional). Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
TLS_SCAN_OIDC_PROVIDER=
TLS_SCAN_OIDC_ISSUER=
TLS_SCAN_OIDC_CLIENT_ID=
TLS_SCAN_OIDC_DEFAULT_ROLE=USER
# Preferably configured in Administration -> Authentication (see docs/admin/authentication.md). Keep all secrets in TLS_SCAN_SECRET_DIR:
# TLS_SCAN_SSO_AUTO_PROVISION=false

# Greenbone import (read-only). GMP hosts must match this exact allowlist.
# Configure password and certificate paths using protected Docker secrets or *_FILE variables.
TLS_SCAN_GREENBONE_ALLOWED_HOSTS=
TLS_SCAN_GREENBONE_USERNAME=
# Set these paths only when the matching protected file has been installed under TLS_SCAN_SECRET_DIR.
TLS_SCAN_GREENBONE_CA_FILE=
TLS_SCAN_GREENBONE_CLIENT_CERT_FILE=
TLS_SCAN_GREENBONE_CLIENT_KEY_FILE=
TLS_SCAN_GOOGLE_DIRECTORY_KEY_FILE=

# Optional read-only SNMPv3 authPriv identity. Keys are managed as protected files by bootstrap.
TLS_SCAN_SNMP_V3_USERNAME=

# Secrets (PostgreSQL, session, SSO/LDAP, SMTP, Greenbone and SNMP) are kept in protected files under
# TLS_SCAN_SECRET_DIR. Do not add *_PASSWORD, *_SECRET or key values here.
